<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Monochord</title>
    
    <!-- Pulling the Premium Fonts from Google Natively -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Codystar&family=Special+Elite&display=swap" rel="stylesheet">

    <style>
        /* Crushed Paper Texture Effect & Layout */
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            
            /* The Organic Crushed Cream Paper Visual Blend */
            background-color: #FAF8F2; 
            background-image: 
                radial-gradient(rgba(0,0,0,0.015) 1px, transparent 0),
                radial-gradient(rgba(0,0,0,0.01) 1px, transparent 0);
            background-size: 8px 8px;
            background-position: 0 0, 4px 4px;
            
            color: #1E293B; /* Deep Indigo Slate */
            overflow: hidden;
        }

        /* Dotted Citylight Main Title with Clean Fading Animation */
        h1 {
            font-family: 'Codystar', sans-serif;
            font-size: 3.5rem;
            margin: 0 0 15px 0;
            letter-spacing: 4px;
            font-weight: 400;
            
            /* The Smooth Clarifying Fade-In Animation */
            animation: clarifyFade 2.5s ease-out forwards;
            opacity: 0;
            filter: blur(5px);
        }

        /* Typewriter Subtext with Delayed Clarifying Animation */
        p {
            font-family: 'Special Elite', monospace;
            font-size: 1.1rem;
            margin: 0;
            letter-spacing: 1px;
            color: #475569;
            
            /* Delayed Animation so it fades in after the main title */
            animation: clarifyFade 2.5s ease-out 1.2s forwards;
            opacity: 0;
            filter: blur(5px);
        }

        /* The Animation Control Script */
        @keyframes clarifyFade {
            0% {
                opacity: 0;
                filter: blur(8px);
                transform: scale(0.98);
            }
            100% {
                opacity: 1;
                filter: blur(0px);
                transform: scale(1);
            }
        }
    </style>
</head>
<body>

    <!-- Accessible for screen-readers naturally -->
    <h1 aria-label="Project Monochord">Project Monochord</h1>
    <p>Translating Data Waves into Financial Literacy for Visually Impaired Youth</p>

</body>
</html>
